{
  "name": "@zhuifengqug/dsh-mantis",
  "version": "1.0.10",
  "description": "虫珀 · 拒斧：装在本机的 DeepSeek Harness 红队评测与宿主清洗插件。面板里一键清洗提示词、审批与沙箱策略，逐条可回滚，只动本机 @deepseek-ai 包。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "mantis": "bin/mantis.js"
  },
  "files": [
    "lib",
    "!lib/*.bak",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "locale",
    "scripts",
    "skills",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "icon.svg"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "register": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuifengqug/dsh-mantis.git"
  },
  "homepage": "https://github.com/zhuifengqug/dsh-mantis#readme",
  "bugs": {
    "url": "https://github.com/zhuifengqug/dsh-mantis/issues"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "install": {
      "preferred": "local",
      "note": "本地自建版：从本目录 npm pack 后 dsh plugin add，不拉任何远端。"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.1",
  "dshTargets": [
    "0.2.2-rc.1"
  ]
}
